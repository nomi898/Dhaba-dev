# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=dhaba
POSTGRES_USER=dhaba
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Required. Use a long random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# --- Redis ---
# Optional locally. If set, also add `requirepass` to database/redis/redis.conf.
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Application ---
APP_VERSION=1.0.0
LOG_LEVEL=INFO
MENU_CACHE_TTL_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173
MENU_API_URL=http://localhost:8000
ORDERS_API_URL=http://localhost:8081
STATS_API_URL=http://localhost:8082

# Kitchen simulation: when true the worker moves NEW -> COOKING -> READY on timers.
# Kitchen staff can always advance orders manually from the dashboard.
KITCHEN_AUTO_ADVANCE=true
KITCHEN_ACCEPT_DELAY=5s
KITCHEN_COOK_TIME=20s
WORKER_MAX_ATTEMPTS=5

